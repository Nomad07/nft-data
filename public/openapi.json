{
  "openapi": "3.1.0",
  "info": {
    "title": "NFT Data",
    "version": "1.0.0",
    "description": "OpenSea Agent Tool that provides structured NFT collection and market data for AI agents.",
    "x-guidance": "POST /api/get-collection-data with a JSON body containing a 'collection' field set to an OpenSea collection slug (e.g. 'doodles-official'). Requires x402 USDC payment on Base (0.01 USDC per request). Returns structured collection metadata, floor price, volume, sales, and owner data sourced from the OpenSea API v2."
  },
  "paths": {
    "/api/get-collection-data": {
      "post": {
        "operationId": "get_collection_data",
        "summary": "Get NFT collection data",
        "description": "Returns structured NFT collection and market data for a given OpenSea collection slug. Requires x402 USDC payment on Base.",
        "tags": ["NFT Data"],
        "x-payment-info": {
          "protocols": [
            {
              "x402": {}
            }
          ],
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.01"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "collection": {
                    "type": "string",
                    "description": "OpenSea collection slug (e.g. 'doodles-official'). The slug is the unique identifier visible in the collection's OpenSea URL.",
                    "minLength": 1,
                    "pattern": "^[a-z0-9][a-z0-9_-]*$"
                  }
                },
                "required": ["collection"]
              },
              "example": {
                "collection": "doodles-official"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response with structured NFT collection data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Collection display name."
                    },
                    "slug": {
                      "type": "string",
                      "description": "Collection slug."
                    },
                    "contracts": {
                      "type": "array",
                      "description": "NFT contract addresses and their chains.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "address": { "type": "string" },
                          "chain": { "type": "string" }
                        }
                      }
                    },
                    "floor_price": {
                      "type": "number",
                      "description": "Current floor price of the collection."
                    },
                    "floor_price_currency": {
                      "type": "string",
                      "description": "Currency symbol for the floor price (e.g. ETH, USDC, HYPE)."
                    },
                    "one_day_sales": {
                      "type": "number",
                      "description": "Number of sales in the last 24 hours."
                    },
                    "one_day_volume": {
                      "type": "number",
                      "description": "Trading volume in the last 24 hours."
                    },
                    "one_day_volume_currency": {
                      "type": ["string", "null"],
                      "description": "Currency symbol for 24-hour volume."
                    },
                    "seven_day_sales": {
                      "type": ["number", "null"],
                      "description": "Number of sales in the last 7 days."
                    },
                    "seven_day_volume": {
                      "type": ["number", "null"],
                      "description": "Trading volume in the last 7 days."
                    },
                    "seven_day_volume_currency": {
                      "type": ["string", "null"],
                      "description": "Currency symbol for 7-day volume."
                    },
                    "thirty_day_sales": {
                      "type": ["number", "null"],
                      "description": "Number of sales in the last 30 days."
                    },
                    "thirty_day_volume": {
                      "type": ["number", "null"],
                      "description": "Trading volume in the last 30 days."
                    },
                    "thirty_day_volume_currency": {
                      "type": ["string", "null"],
                      "description": "Currency symbol for 30-day volume."
                    },
                    "total_sales": {
                      "type": "number",
                      "description": "Total lifetime sales count."
                    },
                    "total_volume": {
                      "type": "number",
                      "description": "Total lifetime trading volume."
                    },
                    "total_volume_currency": {
                      "type": ["string", "null"],
                      "description": "Currency symbol for total lifetime volume."
                    },
                    "num_owners": {
                      "type": "number",
                      "description": "Current number of unique owners."
                    },
                    "total_supply": {
                      "type": ["number", "null"],
                      "description": "Total number of NFTs in the collection."
                    },
                    "created_date": {
                      "type": ["string", "null"],
                      "description": "Collection creation date (ISO 8601)."
                    }
                  },
                  "required": [
                    "name", "slug", "contracts",
                    "floor_price", "floor_price_currency",
                    "one_day_sales", "one_day_volume",
                    "total_sales", "total_volume", "num_owners"
                  ]
                },
                "example": {
                  "name": "based punks",
                  "slug": "basedpunks",
                  "contracts": [
                    {
                      "address": "0xcb28749c24af4797808364d71d71539bc01e76d4",
                      "chain": "base"
                    }
                  ],
                  "floor_price": 0.02391776,
                  "floor_price_currency": "ETH",
                  "one_day_sales": 1,
                  "one_day_volume": 0.0185,
                  "one_day_volume_currency": "ETH",
                  "seven_day_sales": 16,
                  "seven_day_volume": 0.34213836,
                  "seven_day_volume_currency": "ETH",
                  "thirty_day_sales": 217,
                  "thirty_day_volume": 1.50135021,
                  "thirty_day_volume_currency": "ETH",
                  "total_sales": 18027,
                  "total_volume": 4728.074488347124,
                  "total_volume_currency": "ETH",
                  "num_owners": 2408,
                  "total_supply": 5000,
                  "created_date": "2024-04-05"
                }
              }
            }
          },
          "400": {
            "description": "Bad request. Missing or invalid collection slug.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Payment Required. Include a valid x402 payment header to access this endpoint."
          },
          "404": {
            "description": "Collection not found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded. Retry after the indicated delay.",
            "headers": {
              "Retry-After": {
                "schema": { "type": "string" },
                "description": "Seconds to wait before retrying."
              }
            }
          }
        }
      }
    }
  }
}
